attr(data, "na.action") <- NULL
View(data)
hist(data$Platform)
hist(data$Year)
library(ggplot2)
ggplot(data = data, aes(x = data$Global_Sales, y = data$Year)) +
geom_point() + # Cambia geom_point() por geom_bar() para barras o geom_line() para líneas
labs(title = "Mi Gráfico", x = "Eje X", y = "Eje Y")
ggplot(data = data, aes(x = data$Year, y = data$Global_Sales)) +
geom_point() + # Cambia geom_point() por geom_bar() para barras o geom_line() para líneas
labs(title = "Mi Gráfico", x = "Eje X", y = "Eje Y")
library(dplyr)
data_genre <- data %>%
group_by(Genre) %>%
summarise(Total_Sales = sum(Global_Sales))
ggplot(data_genre, aes(x = reorder(Genre, Total_Sales), y = Total_Sales, fill = Genre)) +
geom_bar(stat = "identity", color = "white", alpha = 0.9) +
coord_flip() +  # Hace que las barras sean horizontales
labs(
title = "Distribución de Ventas Globales por Género de Videojuego",
subtitle = "Expresado en millones de copias vendidas",
x = "Género",
y = "Ventas Totales (Millones)"
) +
theme_minimal() +
theme(
legend.position = "none", # Quitamos la leyenda porque los nombres ya están en el eje
plot.title = element_text(face = "bold", size = 14),
axis.text = element_text(size = 10)
)
data_platform <- data %>%
group_by(Platform) %>%
summarise(Total_Sales = sum(Global_Sales)) %>%
top_n(10, Total_Sales) # Selecciona automáticamente las 10 superiores
ggplot(data_platform, aes(x = reorder(Platform, -Total_Sales), y = Total_Sales, fill = Platform)) +
geom_bar(stat = "identity", alpha = 0.85) +
labs(
title = "Top 10 Plataformas Líderes en Ventas Históricas",
subtitle = "Séptima generación y consolas históricas dominantes",
x = "Plataforma",
y = "Ventas Totales (Millones de copias)"
) +
theme_minimal() +
theme(
legend.position = "none",
plot.title = element_text(face = "bold", size = 14),
axis.text.x = element_text(vjust = 0.5, size = 11)
)
data_platform <- data %>%
group_by(Platform) %>%
summarise(Total_Sales = sum(Global_Sales)) %>%
top_n(-10, Total_Sales)
ggplot(data_platform, aes(x = reorder(Platform, -Total_Sales), y = Total_Sales, fill = Platform)) +
geom_bar(stat = "identity", alpha = 0.85) +
labs(
title = "Ultimas 10 plataformas con menos ventas",
x = "Plataforma",
y = "Ventas Totales (Millones de copias)"
) +
theme_minimal() +
theme(
legend.position = "none",
plot.title = element_text(face = "bold", size = 14),
axis.text.x = element_text(vjust = 0.5, size = 11)
)
