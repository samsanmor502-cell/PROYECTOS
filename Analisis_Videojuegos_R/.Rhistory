library(ggplot2)
library(dplyr)
modelo_multiple <- lm(Global_Sales ~ NA_Sales + EU_Sales + JP_Sales, data = data)
summary(modelo_multiple)
ggplot(data, aes(x = Predicciones, y = Global_Sales)) +
geom_point(alpha = 0.4, color = "steelblue") +
geom_abline(slope = 1, intercept = 0, color = "darkred", linetype = "dashed", size = 1) +
labs(
title = "Modelo 1: Valores Reales vs. Predicciones de Ventas",
subtitle = "Regresión Lineal Múltiple (NA, EU, JP)",
x = "Ventas Predichas por el Modelo (Millones)",
y = "Ventas Globales Reales (Millones)"
) +
theme_minimal()
data$Predicciones <- predict(modelo_multiple)
ggplot(data, aes(x = Predicciones, y = Global_Sales)) +
geom_point(alpha = 0.4, color = "steelblue") +
geom_abline(slope = 1, intercept = 0, color = "darkred", linetype = "dashed", size = 1) +
labs(
title = "Modelo 1: Valores Reales vs. Predicciones de Ventas",
subtitle = "Regresión Lineal Múltiple (NA, EU, JP)",
x = "Ventas Predichas por el Modelo (Millones)",
y = "Ventas Globales Reales (Millones)"
) +
theme_minimal()
library(ggplot2)
library(caret)
library(randomForest)
data <- data %>% mutate(Hit = ifelse(Global_Sales > 1.0, 1, 0))
modelo_logistico <- glm(Hit ~ Genre, data = data, family = binomial)
summary(modelo_logistico)
probabilidades <- data.frame(Genre = unique(data$Genre))
probabilidades$Probabilidad_Hit <- predict(modelo_logistico, newdata = probabilidades, type = "response")
ggplot(probabilidades, aes(x = reorder(Genre, Probabilidad_Hit), y = Probabilidad_Hit, fill = Genre)) +
geom_bar(stat = "identity", alpha = 0.85) +
coord_flip() +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Modelo 2: Probabilidad de que un Juego supere 1 Millón de Copias",
subtitle = "Regresión Logística basada en el Género del Videojuego",
x = "Género",
y = "Probabilidad de ser un 'Hit Comercial'"
) +
theme_minimal() +
theme(legend.position = "none")
data_anual <- data %>%
group_by(Year) %>%
summarise(Ventas_Totales = sum(Global_Sales)) %>%
filter(Year <= 2016)
modelo_polinomial <- lm(Ventas_Totales ~ poly(Year, 2),
data = data_anual)
summary(modelo_polinomial)
ggplot(data_anual, aes(x = Year, y = Ventas_Totales)) +
geom_point(size = 3, color = "darkgreen", alpha = 0.7) +
geom_smooth(method = "lm", formula = y ~ poly(x, 2), color = "red", size = 1.2, se = FALSE) +
labs(
title = "Modelo 3: Ciclo de Vida Histórico de la Industria de Videojuegos",
subtitle = "Regresión Polinomial de Segundo Grado (Efecto Curvatura)",
x = "Año de Lanzamiento",
y = "Ventas Globales Totales (Millones de Copias)"
) +
theme_minimal()
